{
  "name": "nuzlocke-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "AUTH_URL=http://localhost:3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 next dev --port 3000",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" prisma migrate deploy; fi && next build",
    "start": "AUTH_URL=http://localhost:3000 NEXT_PUBLIC_APP_URL=http://localhost:3000 next start --port 3000",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:pull-neon": "bash scripts/db-pull-neon.sh",
    "data:pokemon": "node scripts/generate-pokemon-catalog.mjs",
    "data:lookups": "node scripts/generate-pokemon-lookups.mjs",
    "data:moves": "node scripts/generate-expansion-moves.mjs",
    "data:modern-moves": "node scripts/generate-modern-moves.mjs",
    "data:modern-species": "node scripts/generate-modern-emerald-species.mjs",
    "data:learnsets": "node scripts/generate-modern-emerald-learnsets.mjs",
    "data:move-meta": "node scripts/generate-move-meta.mjs",
    "data:held-items": "node scripts/generate-held-item-descriptions.mjs",
    "data:base-stats": "node scripts/generate-base-stats.mjs",
    "data:types": "node scripts/generate-pokemon-types.mjs",
    "data:evolutions": "node scripts/generate-species-evolutions.mjs",
    "data:catch-routes": "node scripts/generate-catch-routes.mjs",
    "data:randomizer": "node scripts/generate-randomizer-tables.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.35",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.54",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "emoji-picker-react": "^4.19.1",
    "fuse.js": "^7.5.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0",
    "sharp": "$sharp"
  }
}
