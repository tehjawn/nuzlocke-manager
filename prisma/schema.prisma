// Nuzlocke Manager — core domain schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  PLAYER
  GAME_MASTER
  SPECTATOR
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  TOURNAMENT
  ARCHIVED
}

enum ChallengeVisibility {
  INVITE
  UNLISTED
  PUBLIC
}

enum PokemonSlot {
  MAIN
  RESERVE
  GRAVEYARD
  ENCOUNTERED
}

enum ActivityType {
  STATUS_UPDATE
  CATCH
  DEATH
  BADGE_EARNED
  BADGE_REVOKED
  REVIVE_USED
  REVIVE_RESET
  MAIN_SQUAD_LOCKED
  MEMBER_JOINED
  TRAINER_CLAIMED
  RULE_UPDATED
  NOTE
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  discordId   String?  @unique
  name        String?
  displayName String?
  image       String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   ChallengeMembership[]
  trainers      TrainerProfile[]
  activities    ActivityEvent[]       @relation("ActivityActor")
  reactions     ActivityReaction[]
  notifications Notification[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// WELCOME | SYSTEM | …
  type      String
  title     String
  body      String?
  /// Client action key (e.g. "welcome") for opening modals / deep links
  actionKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@unique([userId, type, actionKey])
}

model Challenge {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  year              Int
  game              String?
  description       String?
  status            ChallengeStatus     @default(DRAFT)
  visibility        ChallengeVisibility @default(INVITE)
  playerInviteCode  String?
  gmInviteCode      String?
  /// Discord incoming webhook URL for death / badge / revive posts
  discordWebhookUrl String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  rules       ChallengeRule[]
  faqs        FaqEntry[]
  badges      BadgeDefinition[]
  memberships ChallengeMembership[]
  trainers    TrainerProfile[]
  activities  ActivityEvent[]
  tournament  Tournament?
}

model ChallengeRule {
  id          String    @id @default(cuid())
  challengeId String
  sortOrder   Int
  title       String?
  body        String
  isCore      Boolean   @default(false)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, sortOrder])
}

model FaqEntry {
  id          String    @id @default(cuid())
  challengeId String
  sortOrder   Int
  question    String
  answer      String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, sortOrder])
}

model BadgeDefinition {
  id          String    @id @default(cuid())
  challengeId String
  key         String
  label       String
  sortOrder   Int
  category    String
  leaderName  String?
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    BadgeProgress[]

  @@unique([challengeId, key])
  @@index([challengeId, sortOrder])
}

model ChallengeMembership {
  id          String         @id @default(cuid())
  challengeId String
  userId      String
  role        MembershipRole @default(PLAYER)
  joinedAt    DateTime       @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model TrainerProfile {
  id              String   @id @default(cuid())
  challengeId     String
  userId          String?
  handle          String
  realName        String?
  avatarSpriteKey String?
  statusText      String?
  reviveUsed      Boolean  @default(false)
  mainSquadLocked Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  challenge  Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  badges     BadgeProgress[]
  pokemon    PokemonEntry[]
  activities ActivityEvent[]
  matchAsA   TournamentMatch[] @relation("MatchTrainerA")
  matchAsB   TournamentMatch[] @relation("MatchTrainerB")
  matchWins  TournamentMatch[] @relation("MatchWinner")

  @@unique([challengeId, handle])
  @@index([challengeId, sortOrder])
  @@index([userId])
}

model BadgeProgress {
  id        String    @id @default(cuid())
  trainerId String
  badgeId   String
  earned    Boolean   @default(false)
  earnedAt  DateTime?

  trainer TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  badge   BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([trainerId, badgeId])
}

model PokemonEntry {
  id           String      @id @default(cuid())
  trainerId    String
  slot         PokemonSlot
  partyIndex   Int         @default(0)
  nickname     String?
  species      String
  pokedexId    Int?
  isShiny      Boolean     @default(false)
  types        String[]
  nature       String?
  level        Int?
  ability      String?
  catchRoute   String?
  heldItem     String?
  moves        String[]
  /// { hp, atk, def, spa, spd, spe } — each 0–31
  ivs          Json?
  /// { hp, atk, def, spa, spd, spe } — each 0–255
  evs          Json?
  causeOfDeath String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, slot, partyIndex])
}

model ActivityEvent {
  id          String       @id @default(cuid())
  challengeId String
  actorId     String?
  trainerId   String?
  type        ActivityType
  message     String
  metadata    Json?
  createdAt   DateTime     @default(now())

  challenge Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  actor     User?              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  trainer   TrainerProfile?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  reactions ActivityReaction[]

  @@index([challengeId, createdAt])
}

model ActivityReaction {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())

  activity ActivityEvent @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, emoji])
  @@index([activityId])
}

model Tournament {
  id          String   @id @default(cuid())
  challengeId String   @unique
  name        String?
  /// DRAFT | ACTIVE | COMPLETE
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  matches   TournamentMatch[]
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int
  sortOrder    Int      @default(0)
  label        String?
  trainerAId   String?
  trainerBId   String?
  winnerId     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  trainerA   TrainerProfile? @relation("MatchTrainerA", fields: [trainerAId], references: [id], onDelete: SetNull)
  trainerB   TrainerProfile? @relation("MatchTrainerB", fields: [trainerBId], references: [id], onDelete: SetNull)
  winner     TrainerProfile? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([tournamentId, round, sortOrder])
}
