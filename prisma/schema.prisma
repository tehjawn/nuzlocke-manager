// Nuzlocke Manager — core domain schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  PLAYER
  GAME_MASTER
  SPECTATOR
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  TOURNAMENT
  ARCHIVED
}

enum ChallengeVisibility {
  INVITE
  UNLISTED
  PUBLIC
}

enum PokemonSlot {
  MAIN
  RESERVE
  GRAVEYARD
  ENCOUNTERED
}

enum ActivityType {
  STATUS_UPDATE
  CATCH
  DEATH
  BADGE_EARNED
  BADGE_REVOKED
  REVIVE_USED
  REVIVE_RESET
  MAIN_SQUAD_LOCKED
  MEMBER_JOINED
  TRAINER_CLAIMED
  RULE_UPDATED
  NOTE
  WIPE
}

/// Why a trainer board snapshot was taken (pre-mutation boundary).
enum BoardSnapshotTrigger {
  IMPORT
  WIPE
  GM_RESET
}

/// Lifecycle of a single Nuzlocke attempt on a trainer board.
enum TrainerRunStatus {
  ACTIVE
  CLOSED
}

enum TrainerRunEndReason {
  WIPE
  GM_RESET
}

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  SUPPORT
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  discordId       String?  @unique
  /// Discord login username (for @mentions); not the global display name.
  discordUsername String?
  name            String?
  displayName     String?
  image           String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   ChallengeMembership[]
  trainers      TrainerProfile[]
  activities    ActivityEvent[]       @relation("ActivityActor")
  feedback      FeedbackSubmission[]
  reactions     ActivityReaction[]
  notifications Notification[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// WELCOME | SYSTEM | FEEDBACK | FEEDBACK_STATUS | …
  type      String
  title     String
  body      String?
  /// Client action key (e.g. "welcome") for opening modals / deep links
  actionKey String?
  readAt    DateTime?
  /// Soft-dismiss — hidden from the inbox but kept for audit / unique keys
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, archivedAt])
  @@unique([userId, type, actionKey])
}

model Challenge {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  year              Int
  game              String?
  description       String?
  status            ChallengeStatus     @default(DRAFT)
  visibility        ChallengeVisibility @default(INVITE)
  playerInviteCode  String?
  gmInviteCode      String?
  /// Discord incoming webhook URL for death / badge / revive posts
  discordWebhookUrl String?
  /// Get Started welcome video (YouTube, Drive, or direct media). Null = env fallback.
  welcomeVideoUrl String?
  /// When the Get Started welcome video becomes visible to everyone (Eastern schedule; null = default).
  welcomeVideoPublishAt DateTime?
  /// Get Started ROM download URL. Null = built-in Trash Pack Drive link.
  romUrl String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  rules       ChallengeRule[]
  faqs        FaqEntry[]
  badges      BadgeDefinition[]
  memberships ChallengeMembership[]
  trainers    TrainerProfile[]
  activities  ActivityEvent[]
  snapshots   TrainerBoardSnapshot[]
  tournament  Tournament?
  feedback    FeedbackSubmission[]
}

model FeedbackSubmission {
  id          String           @id @default(cuid())
  challengeId String
  userId      String
  category    FeedbackCategory
  subject     String
  message     String
  status      FeedbackStatus   @default(NEW)
  /// GM reply visible to the requester (may include links).
  gmNote      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeId, status, createdAt])
  @@index([userId, createdAt])
}

model ChallengeRule {
  id          String    @id @default(cuid())
  challengeId String
  sortOrder   Int
  title       String?
  body        String
  isCore      Boolean   @default(false)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, sortOrder])
}

model FaqEntry {
  id          String    @id @default(cuid())
  challengeId String
  sortOrder   Int
  question    String
  answer      String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, sortOrder])
}

model BadgeDefinition {
  id          String    @id @default(cuid())
  challengeId String
  key         String
  label       String
  sortOrder   Int
  category    String
  leaderName  String?
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  progress    BadgeProgress[]

  @@unique([challengeId, key])
  @@index([challengeId, sortOrder])
}

model ChallengeMembership {
  id          String         @id @default(cuid())
  challengeId String
  userId      String
  role        MembershipRole @default(PLAYER)
  joinedAt    DateTime       @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model TrainerProfile {
  id              String   @id @default(cuid())
  challengeId     String
  userId          String?
  handle          String
  realName        String?
  avatarSpriteKey      String?
  avatarBackgroundKey  String?
  cardBackgroundKey    String?
  statusText           String?
  statusEmoji          String?
  reviveUsed      Boolean  @default(false)
  /// Closed-run count this season; active run number is wipeCount + 1.
  wipeCount       Int      @default(0)
  /// Last imported Pokédollars from Gen 3 save (null = unknown / never imported).
  money           Int?
  mainSquadLocked Boolean  @default(false)
  sortOrder       Int      @default(0)
  /// Pointer to the living attempt; closed runs remain in `runs` for stats.
  activeRunId     String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  challenge  Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  activeRun  TrainerRun?     @relation("ActiveTrainerRun", fields: [activeRunId], references: [id], onDelete: SetNull)
  runs       TrainerRun[]    @relation("TrainerRuns")
  badges     BadgeProgress[]
  pokemon    PokemonEntry[]
  activities ActivityEvent[]
  snapshots  TrainerBoardSnapshot[]
  matchAsA   TournamentMatch[] @relation("MatchTrainerA")
  matchAsB   TournamentMatch[] @relation("MatchTrainerB")
  matchWins  TournamentMatch[] @relation("MatchWinner")

  @@unique([challengeId, handle])
  /// One claimed board per user per season (DB: partial unique WHERE userId IS NOT NULL).
  @@unique([challengeId, userId])
  @@index([challengeId, sortOrder])
  @@index([userId])
}

/// One Nuzlocke attempt for a trainer within a season.
/// Wipe closes the active run and opens the next; memorial graves stay on the trainer.
model TrainerRun {
  id               String               @id @default(cuid())
  trainerId        String
  /// 1-based attempt index (matches diedOnRun / wipeCount + 1 while active).
  runNumber        Int
  status           TrainerRunStatus     @default(ACTIVE)
  startedAt        DateTime             @default(now())
  endedAt          DateTime?
  endReason        TrainerRunEndReason?
  /// Trainer.wipeCount when this run began (0 for run 1).
  wipeCountAtStart Int                  @default(0)
  /// Per-run revive token (mirrored on TrainerProfile.reviveUsed for the ACTIVE run).
  reviveUsed       Boolean              @default(false)
  /// Badge keys earned when this run closed (career archive). Empty while ACTIVE.
  earnedBadgeKeys  String[]             @default([])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  trainer          TrainerProfile       @relation("TrainerRuns", fields: [trainerId], references: [id], onDelete: Cascade)
  pokemon          PokemonEntry[]
  snapshots        TrainerBoardSnapshot[]
  activeForTrainer TrainerProfile?      @relation("ActiveTrainerRun")

  @@unique([trainerId, runNumber])
  @@index([trainerId, status])
}

/// Point-in-time board copy taken before import / wipe / GM reset.
/// Survives hard clears of live PokemonEntry / BadgeProgress rows.
model TrainerBoardSnapshot {
  id          String               @id @default(cuid())
  challengeId String
  trainerId   String
  /// Run this snapshot belonged to when captured (active run at capture time).
  runId       String?
  actorId     String?
  trigger     BoardSnapshotTrigger
  label       String?
  /// { wipeCount, reviveUsed, mainSquadLocked, earnedBadgeKeys, pokemon[] }
  payload     Json
  createdAt   DateTime             @default(now())

  challenge Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  run       TrainerRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([trainerId, createdAt])
  @@index([challengeId, createdAt])
  @@index([runId, createdAt])
}

model BadgeProgress {
  id        String    @id @default(cuid())
  trainerId String
  badgeId   String
  earned    Boolean   @default(false)
  earnedAt  DateTime?

  trainer TrainerProfile  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  badge   BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([trainerId, badgeId])
}

model PokemonEntry {
  id           String      @id @default(cuid())
  trainerId    String
  slot         PokemonSlot
  partyIndex   Int         @default(0)
  nickname     String?
  species      String
  pokedexId    Int?
  isShiny      Boolean     @default(false)
  types        String[]
  nature       String?
  level        Int?
  ability      String?
  catchRoute   String?
  heldItem     String?
  moves        String[]
  /// { hp, atk, def, spa, spd, spe } — each 0–31
  ivs          Json?
  /// { hp, atk, def, spa, spd, spe } — each 0–255
  evs          Json?
  causeOfDeath String?
  /// 1-based run attempt when this mon entered GRAVEYARD (wipeCount + 1 at death).
  diedOnRun    Int?
  /// Run this entry belongs to (living board = active run; graves = run of death).
  runId        String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  run     TrainerRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([trainerId, slot, partyIndex])
  @@index([runId])
}

model ActivityEvent {
  id          String       @id @default(cuid())
  challengeId String
  actorId     String?
  trainerId   String?
  type        ActivityType
  message     String
  metadata    Json?
  createdAt   DateTime     @default(now())

  challenge Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  actor     User?              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  trainer   TrainerProfile?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  reactions ActivityReaction[]

  @@index([challengeId, createdAt])
}

model ActivityReaction {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  emoji      String
  createdAt  DateTime @default(now())

  activity ActivityEvent @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, emoji])
  @@index([activityId])
}

model Tournament {
  id          String   @id @default(cuid())
  challengeId String   @unique
  name        String?
  /// DRAFT | ACTIVE | COMPLETE
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  matches   TournamentMatch[]
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int
  sortOrder    Int      @default(0)
  label        String?
  trainerAId   String?
  trainerBId   String?
  winnerId     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  trainerA   TrainerProfile? @relation("MatchTrainerA", fields: [trainerAId], references: [id], onDelete: SetNull)
  trainerB   TrainerProfile? @relation("MatchTrainerB", fields: [trainerBId], references: [id], onDelete: SetNull)
  winner     TrainerProfile? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([tournamentId, round, sortOrder])
}
