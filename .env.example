# Postgres — prefer localhost for development so you don't burn Neon egress.
# Docker: `docker compose up -d` then use the URL below (Postgres 18).
# Production (Vercel): Neon pooled URL for DATABASE_URL; direct host for UNPOOLED.
DATABASE_URL="postgresql://nuzlocke:nuzlocke@localhost:5432/nuzlocke_manager"
# DATABASE_URL_UNPOOLED="postgresql://…@ep-….neon.tech/neondb?sslmode=require"

# Neon (remote) — used by `npm run db:pull-neon` to snapshot into local Docker.
# Prefer the direct (non-pooler) connection string.
# NEON_DATABASE_URL="postgresql://…@ep-….neon.tech/neondb?sslmode=require"

# Optional: cap pg Pool size per serverless isolate (default 3)
# PG_POOL_MAX=3

# Optional: log Prisma queries in development (egress tuning)
# PRISMA_QUERY_LOG=1

# App URL — production / absolute links. Local `npm run dev` pins :3000.
# Auth.js uses trustHost, so omit AUTH_URL locally; set it on Vercel to the
# canonical site origin (e.g. https://your-app.vercel.app).
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Discord OAuth app (https://discord.com/developers/applications)
# Redirect URL (matches pinned dev port):
#   http://localhost:3000/api/auth/callback/discord
# Optional extras if you ever run another port: :3001 / :3002 callbacks too.
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Optional fallback welcome video URL (YouTube, Google Drive, or direct .mp4).
# Prefer setting Embed welcome video URL per season in the GM console.
# NEXT_PUBLIC_WELCOME_VIDEO_URL="https://drive.google.com/file/d/…/view"

# Vercel Blob — custom trainer avatar uploads
# Created with the Blob store in the Vercel dashboard / `vercel blob`.
# Pull with: vercel env pull .env.local
# BLOB_READ_WRITE_TOKEN=""

# Upstash Redis (Vercel KV) — optional Pack-feed poll watermark only.
# Fail-open if unset. Leave unset locally unless you are testing watermarks.
# Pull via `vercel env pull`. Do not commit tokens.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Google AI Studio (Gemini) — Jump LLM assist (#184). Server-only.
# Create at https://aistudio.google.com/apikey
# Uses a Flash-Lite model on the free tier. Fail-open if unset.
# Set on Vercel for Production + Preview; keep the real key in .env.local.
# GOOGLE_GENERATIVE_AI_API_KEY=""

# Feature flags (NEXT_PUBLIC_* are build-time on Vercel).
# ai-drawer (#300): Ask as a full-height right rail + rich answers.
# Off → original Ask-inside-Jump modal. On → drawer layout.
# Local/preview toggle without rebuild: visit ?ff=ai-drawer (or ?ff=-ai-drawer).
# NEXT_PUBLIC_FEATURE_AI_DRAWER=1
